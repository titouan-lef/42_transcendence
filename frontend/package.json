{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "lint:ts": "eslint . --ext .ts --max-warnings=0",
    "lint:html": "htmlhint '**/*.html'",
    "format:check": "npm run lint:html && npm run lint:ts && madge --circular --extensions ts ./src",
    "build:css": "npx @tailwindcss/cli -i ./src/assets/style.css -o ./dist/assets/style.css --minify",
    "build:ts_server": "tsc -p tsconfig.build.json",
    "build:ts_client": "npx esbuild src/main.ts --bundle --minify --sourcemap --outfile=dist/public/bundle.js --platform=browser --target=es2022",
    "build": "npm run build:css && npm run build:ts_server && npm run build:ts_client",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "@fastify/static": "8.2.0",
    "@types/node": "24.7.0",
    "tailwindcss": "4.1.14",
    "@babylonjs/core": "8.31.2"
  },
  "devDependencies": {
    "esbuild": "0.26.0",
    "typescript": "5.9.3",
    "eslint": "9.37.0",
    "htmlhint": "1.7.1",
    "@typescript-eslint/parser": "8.46.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@stylistic/eslint-plugin": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "madge": "8.0.0",
    "@tailwindcss/cli": "4.1.14",
    "tailwind-scrollbar": "4.0.2",
    "chart.js": "4.5.1",
    "@types/chart.js": "2.9.41"
  }
}
