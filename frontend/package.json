{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/main.ts",
  "scripts": {
    "lint:ts": "eslint . --ext .ts --max-warnings=0",
    "lint:html": "htmlhint '**/*.html'",
    "format:check": "npm run lint:html && npm run lint:ts",
    "build:css": "tailwindcss -i ./src/style.css -o ./dist/style.css --minify",
    "build:ts": "tsc",
    "build": "npm run build:css && npm run build:ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "@fastify/static": "8.2.0",
    "@types/node": "24.7.0",
    "tailwindcss": "3.4.0",
	"babylonjs": "^8.31.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.37.0",
    "htmlhint": "1.7.1",
    "@typescript-eslint/parser": "8.46.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "eslint-plugin-import": "2.32.0"
  }
}