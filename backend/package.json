{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint:ts": "eslint . --ext .ts --max-warnings=0",
    "format:check": "npm run lint:ts",
    "build:ts": "tsc -p ./backend/tsconfig.json",
    "build": "npm run build:ts",
    "start": "node ./dist/backend/src/index.js"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "@fastify/cors": "11.1.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/websocket": "11.2.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/static": "8.2.0",
    "@types/node": "24.7.0",
    "@types/ws": "8.18.1",
    "sqlite": "5.1.1",
    "sqlite3": "5.1.6",
    "jsonwebtoken": "9.0.2",
    "@types/jsonwebtoken": "9.0.10",
    "@babylonjs/core": "8.31.2",
    "@babylonjs/havok": "1.3.10",
    "ethers": "6.16.0",
    "dotenv": "17.2.3",
    "nodemailer": "7.0.11",
    "@types/nodemailer": "7.0.4",
    "sharp": "0.34.5",
    "gifsicle": "7.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.37.0",
    "@typescript-eslint/parser": "8.46.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@stylistic/eslint-plugin": "5.4.0",
    "eslint-plugin-import": "2.32.0"
  },
  "imports": {
    "#shared/*": "./dist/shared/*"
  }
}
