{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext", //ESNext
    "moduleResolution": "Node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "#shared/*": ["shared/*"]
    }
  },
  "include": ["src", "shared"]
}
